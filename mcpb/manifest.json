{
  "manifest_version": "0.3",
  "name": "voidpay-marketplace",
  "display_name": "Voidpay Marketplace",
  "version": "0.7.1",
  "description": "Discover Voidpay marketplace services and hand off checkout to the owner's browser.",
  "author": {
    "name": "Voidly"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voidly-ai/pay-mcp"
  },
  "homepage": "https://voidly.ai/pay",
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/cli.js"
      ],
      "env": {}
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=24.15.0 <25"
    }
  }
}
